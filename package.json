{
  "name": "agenda",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter @agenda/api --filter @agenda/web dev",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "corepack pnpm --filter @agenda/api test:integration",
    "test:e2e": "corepack pnpm --filter @agenda/web test:e2e",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
